.pet-hero {
  margin-bottom: 18rpx;
}

.pet-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.pet-avatar-shell {
  position: relative;
}

.pet-avatar {
  width: 94rpx;
  height: 94rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, rgba(212, 165, 116, 0.12) 0%, rgba(159, 180, 168, 0.12) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.pet-main {
  flex: 1;
}

.pet-topline {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.pet-name {
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #2e2a27;
}

.pet-age {
  font-size: 20rpx;
  line-height: 1.5;
  color: #827c76;
}

.pet-meta {
  font-size: 22rpx;
  line-height: 1.6;
  color: #78726c;
}

.pet-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: #8a847d;
}

.action-row {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.action-card {
  background: rgba(255, 255, 255, 0.98);
}

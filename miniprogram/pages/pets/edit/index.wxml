<view class="page-shell">
  <view class="light-card">
    <view class="section-title">{{isEdit ? '编辑猫咪' : '新增猫咪'}}</view>
    <view class="form-label">姓名</view>
    <input class="input" value="{{name}}" data-field="name" bindinput="handleInput" placeholder="请输入猫咪名字" />

    <view class="form-label">生日</view>
    <view class="input picker-input" bindtap="openDatePicker">{{birthday || '请选择生日'}}</view>

    <view class="form-label">品种</view>
    <input class="input" value="{{breed}}" data-field="breed" bindinput="handleInput" placeholder="例如英短、田园猫" />

    <view class="form-label">性别</view>
    <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="handleGenderChange">
      <view class="input picker-input">{{genderOptions[genderIndex]}}</view>
    </picker>

    <view class="form-label">绝育状态</view>
    <picker mode="selector" range="{{neuteredOptions}}" value="{{neuteredIndex}}" bindchange="handleNeuteredChange">
      <view class="input picker-input">{{neuteredOptions[neuteredIndex]}}</view>
    </picker>

    <view class="form-label">头像占位文字</view>
    <input class="input" value="{{avatarText}}" data-field="avatarText" bindinput="handleInput" placeholder="默认取名字第一个字" />

    <view class="form-label">备注</view>
    <textarea class="textarea" value="{{note}}" data-field="note" bindinput="handleInput" placeholder="记录猫咪性格或注意事项"></textarea>
  </view>

  <view class="light-card">
    <view class="section-title">AI 专属头像</view>
    <view class="row-desc">入口已预留。后续支持上传猫咪照片，生成可爱的专属头像并支持刷新重生成。</view>
  </view>

  <button class="primary-button sticky-button" bindtap="savePet">保存猫咪资料</button>
  <date-sheet-picker
    visible="{{datePickerVisible}}"
    title="选择生日"
    value="{{datePickerCurrentValue}}"
    bind:close="closeDatePicker"
    bind:confirm="handleBirthdayConfirm"
  />
</view>

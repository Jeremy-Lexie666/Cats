.invite-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 98rpx;
  background: #ffffff;
}

.invite-mascot {
  position: absolute;
  right: 18rpx;
  bottom: 16rpx;
  width: 92rpx;
  height: 92rpx;
}

.invite-glow {
  position: absolute;
  inset: 0;
  border-radius: 999rpx;
  background: radial-gradient(circle, rgba(212, 165, 116, 0.28) 0%, rgba(159, 180, 168, 0.16) 62%, rgba(159, 180, 168, 0) 82%);
}

.invite-cat {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #d9c8b2 0%, #c8cbc0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6d6660;
  font-size: 22rpx;
  font-weight: 700;
}

.invite-code-card {
  text-align: left;
}

.invite-code {
  margin-top: 14rpx;
  font-size: 38rpx;
  letter-spacing: 4rpx;
  font-weight: 700;
  color: #b48a5f;
}

.invite-tip {
  margin-top: 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #827c76;
}

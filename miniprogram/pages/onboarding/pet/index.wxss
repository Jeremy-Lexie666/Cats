.onboarding-page {
  min-height: 100vh;
  background: #fdfcfb;
  padding: 0 24rpx calc(env(safe-area-inset-bottom) + 148rpx);
  box-sizing: border-box;
}

.top-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 56rpx;
}

.progress-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-bar {
  width: 34rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #ece8e3;
}

.progress-bar.active,
.progress-bar.done {
  width: 44rpx;
  background: #d4a574;
}

.skip-link {
  font-size: 24rpx;
  line-height: 1.4;
  color: #8d837b;
  font-weight: 600;
}

.step-shell {
  min-height: 980rpx;
  padding-top: 6rpx;
}

.heading-block {
  max-width: 430rpx;
}

.step-title {
  font-size: 56rpx;
  line-height: 1.18;
  color: #2e2a27;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.step-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.62;
  color: #7b726a;
}

.avatar-stage,
.info-avatar-stage,
.final-avatar-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-stage {
  margin-top: 98rpx;
}

.info-avatar-stage {
  margin-top: 70rpx;
}

.final-avatar-stage {
  margin-top: 62rpx;
}

.avatar-card,
.info-avatar-card,
.final-avatar-card {
  width: 252rpx;
  height: 252rpx;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #f8f4ef 0%, #f6f3ef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 104rpx;
}

.info-avatar-card {
  width: 190rpx;
  height: 190rpx;
  border-radius: 32rpx;
  font-size: 84rpx;
}

.final-avatar-card {
  width: 258rpx;
  height: 258rpx;
  border-radius: 38rpx;
  font-size: 110rpx;
}

.field-label {
  margin-top: 0;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #7b726a;
  font-weight: 600;
}

.field-label + .step-input,
.field-label + picker {
  margin-bottom: 0;
}

.form-block {
  margin-top: 60rpx;
}

.form-block .field-label + .step-input {
  margin-bottom: 0;
}

.field-label-spaced {
  margin-top: 34rpx;
}

.step-input {
  min-height: 96rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(212, 165, 116, 0.26);
  background: #ffffff;
  font-size: 24rpx;
  color: #2e2a27;
  box-sizing: border-box;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-placeholder {
  color: #afa59b;
}

.picker-value {
  color: #2e2a27;
}

.picker-icon {
  font-size: 28rpx;
  color: #2e2a27;
}

.tip-card {
  margin-top: 40rpx;
  border-radius: 24rpx;
  background: #faf9f7;
  padding: 20rpx 24rpx;
}

.tip-text {
  font-size: 22rpx;
  line-height: 1.65;
  color: #8a8077;
  text-align: center;
}

.name-badge {
  margin-top: 36rpx;
  min-height: 88rpx;
  border-radius: 28rpx;
  background: #faf9f7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #3a3531;
  font-weight: 600;
}

.final-name {
  margin-top: 28rpx;
  font-size: 42rpx;
  line-height: 1.2;
  color: #2e2a27;
  font-weight: 700;
}

.final-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7e746b;
}

.ghost-upload-button {
  margin-top: 58rpx;
  width: 100%;
  height: 98rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid rgba(46, 42, 39, 0.08);
  color: #2e2a27;
  font-size: 24rpx;
  font-weight: 600;
}

.ghost-upload-button::after {
  border: none;
}

.divider-row {
  margin: 26rpx 0 20rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: rgba(46, 42, 39, 0.08);
}

.divider-text {
  font-size: 22rpx;
  color: #8d837b;
}

.ai-card {
  border-radius: 30rpx;
  border: 1rpx solid rgba(212, 165, 116, 0.12);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(250, 247, 243, 0.98) 100%);
  padding: 28rpx 28rpx 30rpx;
}

.ai-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: rgba(212, 165, 116, 0.12);
  color: #d4a574;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 18rpx;
}

.ai-title {
  font-size: 26rpx;
  line-height: 1.35;
  color: #2e2a27;
  font-weight: 700;
}

.ai-subtitle {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #7f756d;
}

.ai-button {
  margin-top: 24rpx;
  width: 100%;
  height: 78rpx;
  border-radius: 24rpx;
  background: #d4a574;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.ai-button::after {
  border: none;
}

.muted-card {
  margin-top: 24rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(env(safe-area-inset-bottom) + 22rpx);
  background: rgba(253, 252, 251, 0.98);
  border-top: 1rpx solid rgba(46, 42, 39, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.single-bottom-bar {
  justify-content: center;
}

.bottom-primary,
.bottom-secondary {
  height: 92rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.bottom-primary {
  width: 420rpx;
  flex: none;
  background: #d4a574;
  color: #ffffff;
}

.bottom-primary-single {
  flex: none;
  width: 428rpx;
  max-width: 100%;
}

.bottom-secondary {
  width: 176rpx;
  background: #f7f4f1;
  color: #2e2a27;
}

.bottom-primary::after,
.bottom-secondary::after {
  border: none;
}

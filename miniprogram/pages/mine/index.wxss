.mine-title {
  font-size: 38rpx;
  line-height: 1.25;
  color: #2e2a27;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.profile-card {
  background: #ffffff;
}

.profile-head {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.profile-avatar {
  width: 94rpx;
  height: 94rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #d9c8b2 0%, #c8cbc0 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6d6660;
  font-size: 30rpx;
  font-weight: 700;
}

.profile-main {
  flex: 1;
}

.profile-name {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #2e2a27;
}

.profile-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.75;
  color: #78726c;
}

.menu-card {
  overflow: hidden;
}

.entry-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.entry-copy {
  flex: 1;
}

.entry-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.entry-icon.primary {
  color: #d4a574;
  background: rgba(212, 165, 116, 0.08);
}

.entry-icon.accent {
  color: #9fb4a8;
  background: rgba(159, 180, 168, 0.12);
}

.entry-icon.secondary {
  color: #827c76;
  background: #f7f5f3;
}

.entry-icon.muted {
  color: #827c76;
  background: #f0ede9;
}

.entry-arrow {
  color: #827c76;
  font-size: 24rpx;
}

.mine-footer {
  text-align: center;
  padding: 30rpx 0 10rpx;
  font-size: 20rpx;
  line-height: 1.6;
  color: #827c76;
}

.logout-button {
  margin-top: 22rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(46, 42, 39, 0.08);
  background: #ffffff;
  color: #8f5e47;
  font-size: 26rpx;
  font-weight: 600;
}

.logout-button::after {
  border: none;
}

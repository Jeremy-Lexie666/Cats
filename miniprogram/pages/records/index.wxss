.record-hero {
  margin-bottom: 16rpx;
}

.compact-row {
  margin-top: 10rpx;
}

.record-card + .record-card {
  margin-top: 14rpx;
}

.record-row-bottom {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.record-desc {
  flex: 1;
  min-width: 0;
}

.record-date {
  font-size: 22rpx;
  line-height: 1.5;
  color: #8b857f;
}

.record-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.record-action {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(46, 42, 39, 0.06);
  background: #f7f4f1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.record-action.danger {
  background: #fbf1f3;
  border-color: rgba(224, 124, 135, 0.16);
}

.record-action-icon {
  width: 28rpx;
  height: 28rpx;
}

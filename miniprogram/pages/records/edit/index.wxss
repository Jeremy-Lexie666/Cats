.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.back-button,
.back-placeholder {
  width: 32rpx;
  height: 32rpx;
}

.back-button {
  border-radius: 999rpx;
  background: #f7f5f3;
  color: #2e2a27;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.center-title {
  font-size: 28rpx;
  font-weight: 500;
}

.type-switch {
  display: flex;
  gap: 6rpx;
  background: #f7f5f3;
  padding: 6rpx;
  border-radius: 20rpx;
  margin-bottom: 14rpx;
}

.type-tab {
  flex: 1;
  padding: 12rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 18rpx;
  color: #827c76;
}

.type-tab.active {
  background: #ffffff;
  color: #2e2a27;
}

.type-icon {
  margin-bottom: 4rpx;
  font-size: 18rpx;
}

.record-cat-row {
  display: flex;
  gap: 6rpx;
  margin-bottom: 14rpx;
}

.record-cat-chip {
  padding: 10rpx 14rpx;
  border-radius: 16rpx;
  background: #f7f5f3;
  color: #2e2a27;
  font-size: 18rpx;
}

.record-cat-chip.active {
  background: #d4a574;
  color: #ffffff;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  margin: 0 0 6rpx;
  font-size: 18rpx;
  color: #827c76;
}

.picker-input {
  display: flex;
  align-items: center;
}

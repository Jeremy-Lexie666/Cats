.type-switch {
  display: flex;
  gap: 6rpx;
  background: #f7f5f3;
  padding: 6rpx;
  border-radius: 20rpx;
  margin-bottom: 18rpx;
}

.type-tab {
  flex: 1;
  padding: 12rpx 0;
  border-radius: 16rpx;
  text-align: center;
  font-size: 18rpx;
  color: #827c76;
}

.type-tab.active {
  background: #ffffff;
  color: #2e2a27;
}

.type-icon {
  margin-bottom: 4rpx;
  font-size: 18rpx;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.form-label {
  margin: 0 0 6rpx;
  font-size: 18rpx;
  color: #827c76;
}

.picker-input {
  display: flex;
  align-items: center;
}

<view class="splash-page">
  <view class="floating-cat cat-1">🐱</view>
  <view class="floating-cat cat-2">😺</view>
  <view class="floating-cat cat-3">😸</view>
  <view class="floating-cat cat-4">😻</view>
  <view class="floating-cat cat-5">😽</view>
  <view class="floating-cat cat-6">🐈</view>

  <view class="splash-center">
    <view class="brand-stage">
      <view class="brand-pulse"></view>
      <view class="brand-core">
        <view class="brand-heart">♥</view>
        <view class="brand-cat">🐱</view>
      </view>
    </view>

    <view class="brand-title">小猫成长记录</view>
    <view class="brand-subtitle">用爱记录每一天</view>
  </view>

  <view class="auth-panel">
    <button class="wechat-button" loading="{{loading}}" bindtap="handleLogin">
      <view class="wechat-button-inner">
        <view class="wechat-text">微信授权登录</view>
      </view>
    </button>

    <view class="agreement-row">
      <text class="agreement-copy">登录即同意</text>
      <text class="agreement-link" bindtap="openAgreement">《用户协议》</text>
      <text class="agreement-copy">和</text>
      <text class="agreement-link" bindtap="openPrivacy">《隐私政策》</text>
    </view>
  </view>
</view>

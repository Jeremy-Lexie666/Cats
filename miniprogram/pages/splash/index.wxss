.splash-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: linear-gradient(135deg, #f7f5f3 0%, #fdfcfb 52%, #f0ede9 100%);
}

.splash-center {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-stage {
  position: relative;
  width: 192rpx;
  height: 192rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-pulse {
  position: absolute;
  inset: 0;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(212, 165, 116, 0.24) 0%, rgba(159, 180, 168, 0.22) 100%);
  animation: pulse 1.8s ease-in-out infinite;
}

.brand-core {
  position: relative;
  z-index: 1;
  width: 144rpx;
  height: 144rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d4a574 0%, #9fb4a8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: coreFloat 2.5s ease-in-out infinite;
}

.brand-heart {
  color: #ffffff;
  font-size: 64rpx;
  line-height: 1;
  transform: translateY(2rpx);
}

.brand-cat {
  position: absolute;
  right: -6rpx;
  top: -10rpx;
  font-size: 46rpx;
  line-height: 1;
  animation: kittyWiggle 1.8s ease-in-out infinite;
}

.brand-title {
  margin-top: 56rpx;
  font-size: 46rpx;
  line-height: 1.28;
  color: #2e2a27;
  font-weight: 700;
  letter-spacing: -0.6rpx;
}

.brand-subtitle {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #8c837b;
}

.floating-cat {
  position: absolute;
  font-size: 52rpx;
  opacity: 0;
  animation: drift 2.2s ease-in-out infinite;
}

.cat-1 {
  left: 50%;
  top: 44%;
  margin-left: -50rpx;
  margin-top: -110rpx;
  animation-delay: 0s;
}

.cat-2 {
  left: 50%;
  top: 45%;
  margin-left: 44rpx;
  margin-top: -86rpx;
  animation-delay: 0.15s;
}

.cat-3 {
  left: 50%;
  top: 50%;
  margin-left: -92rpx;
  margin-top: 8rpx;
  animation-delay: 0.3s;
}

.cat-4 {
  left: 50%;
  top: 52%;
  margin-left: 86rpx;
  margin-top: 26rpx;
  animation-delay: 0.45s;
}

.cat-5 {
  left: 50%;
  top: 38%;
  margin-left: -4rpx;
  margin-top: -132rpx;
  animation-delay: 0.25s;
}

.cat-6 {
  left: 50%;
  top: 48%;
  margin-left: -110rpx;
  margin-top: -26rpx;
  animation-delay: 0.4s;
}

.auth-panel {
  position: absolute;
  left: 50%;
  bottom: 132rpx;
  transform: translateX(-50%);
  width: calc(100% - 112rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.wechat-button {
  width: 100%;
  height: 92rpx;
  border-radius: 28rpx;
  border: none;
  background: #d4a574;
  box-shadow: 0 18rpx 40rpx rgba(212, 165, 116, 0.16);
}

.wechat-button::after {
  border: none;
}

.wechat-button-inner {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
}

.agreement-row {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.agreement-copy {
  font-size: 20rpx;
  line-height: 1.65;
  color: #92877d;
}

.agreement-link {
  font-size: 20rpx;
  line-height: 1.65;
  color: #d4a574;
  font-weight: 600;
}

@keyframes pulse {
  0% {
    transform: scale(1);
    opacity: 0.42;
  }
  50% {
    transform: scale(1.08);
    opacity: 0.24;
  }
  100% {
    transform: scale(1);
    opacity: 0.42;
  }
}

@keyframes coreFloat {
  0% {
    transform: scale(1) rotate(0deg);
  }
  33% {
    transform: scale(1.03) rotate(3deg);
  }
  66% {
    transform: scale(1.01) rotate(-3deg);
  }
  100% {
    transform: scale(1) rotate(0deg);
  }
}

@keyframes kittyWiggle {
  0% {
    transform: rotate(0deg) translateY(0);
  }
  33% {
    transform: rotate(8deg) translateY(-4rpx);
  }
  66% {
    transform: rotate(-8deg) translateY(0);
  }
  100% {
    transform: rotate(0deg) translateY(0);
  }
}

@keyframes drift {
  0% {
    opacity: 0;
    transform: scale(0.4) translate(0, 0) rotate(0deg);
  }
  25% {
    opacity: 0.85;
    transform: scale(1.08) translate(0, -8rpx) rotate(8deg);
  }
  70% {
    opacity: 0.8;
    transform: scale(1) translate(0, 4rpx) rotate(-8deg);
  }
  100% {
    opacity: 0;
    transform: scale(0.78) translate(0, 0) rotate(0deg);
  }
}

{
  "name": "xiaomaolaile",
  "version": "0.1.0",
  "private": true,
  "description": "微信小程序：小猫成长记录 MVP",
  "scripts": {
    "backend:start": "node backend/server.js",
    "backend:start:prod": "NODE_ENV=production HOST=0.0.0.0 node backend/server.js",
    "doctor": "node scripts/doctor.js",
    "build:miniprogram": "rm -rf dist/miniprogram && tsc -p tsconfig.miniprogram.build.json && npm run copy:miniprogram-assets",
    "copy:miniprogram-assets": "mkdir -p dist/miniprogram && rsync -a --include='*/' --include='*.json' --include='*.wxml' --include='*.wxss' --include='*.svg' --include='*.png' --include='*.jpg' --include='*.jpeg' --include='*.webp' --exclude='*' miniprogram/ dist/miniprogram/",
    "typecheck": "tsc -p tsconfig.miniprogram.json --noEmit",
    "check": "npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.5.1",
    "@types/wechat-miniprogram": "^3.4.7",
    "typescript": "^5.9.2"
  }
}
